{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentakeoff.kentucky-ai.com/protocol/v1/provenance.schema.json",
  "title": "Provenance (draft)",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "seed_norm": {
      "$ref": "common.schema.json#/$defs/point"
    },
    "evidence": {
      "$ref": "evidence.schema.json"
    },
    "assignment": {
      "$ref": "evidence.schema.json#/$defs/assignment"
    },
    "symbol": {
      "$ref": "evidence.schema.json#/$defs/symbol"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_verts_norm": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/point"
      }
    },
    "edits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "agent_edits": {
      "type": "integer",
      "minimum": 0
    },
    "derived": {
      "type": "object",
      "properties": {
        "from_shape_id": {
          "type": "string",
          "minLength": 1
        },
        "gross_lf": {
          "type": "number"
        },
        "openings_lf": {
          "type": "number"
        },
        "between_shape_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "between": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "case": {
          "type": "string"
        },
        "gap_in": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "parent_prev": {
      "$ref": "common.schema.json#/$defs/parentSnapshot"
    },
    "hatch_filtered": {
      "type": "boolean"
    },
    "layer_bounded": {
      "type": "boolean"
    },
    "raster_traced": {
      "type": "boolean"
    },
    "edited": {
      "type": "boolean"
    },
    "edited_before_create": {
      "type": "boolean"
    },
    "copied": {
      "type": "boolean"
    },
    "curved": {
      "type": "boolean"
    },
    "gap_bridged_px": {
      "type": "number"
    },
    "gap_sealed_px": {
      "type": "number"
    },
    "min_pass_px": {
      "type": "number"
    },
    "min_pass_delta": {
      "type": "number"
    },
    "door_wedges": {
      "type": "number"
    },
    "ring_interiors": {
      "type": "number"
    },
    "fill_sensitivity": {
      "type": "number"
    },
    "net_faces": {
      "type": "number"
    },
    "net_starved": {
      "type": "boolean"
    },
    "rule_id": {
      "type": "string"
    },
    "seed_shape_id": {
      "type": "string"
    },
    "container_shape_id": {
      "type": "string"
    },
    "cuts_shape_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "net_mode": {
      "type": "string"
    }
  },
  "required": [
    "method"
  ],
  "additionalProperties": true,
  "description": "Existing origin object. Method and actor are independent strings: manual + agent is valid. Known canvas methods include derived and net_v1 beyond the MCP type union. Unknown values remain unclassified; omission is not verified identity.",
  "allOf": [
    {
      "$ref": "review.schema.json#/$defs/state"
    }
  ]
}
