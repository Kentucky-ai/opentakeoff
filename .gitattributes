# PDFs may contain only ASCII bytes; preserve offsets and fixture hashes on checkout.
*.pdf binary

# CSV snapshots assert the exact bytes emitted by the exporter (LF on all hosts).
web/test/fixtures/*.golden.csv text eol=lf

# The OCR dictionary and model config are sha256-pinned by web/scripts/stage-ocr-model.mjs;
# line-ending conversion on checkout would break the pin.
web/scripts/ocr/* binary
