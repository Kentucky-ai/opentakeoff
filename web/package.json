{
  "name": "opentakeoff-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenTakeoff — a free, open-source PDF takeoff canvas for flooring contractors.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "bench": "node --import tsx bench/run.mts",
    "bench:callouts": "node --import tsx bench/callouts.mts",
    "bench:batch": "node --import tsx bench/batch.mts",
    "check": "npm run typecheck && npm run lint && npm test && npm run bench && npm run build",
    "styles:sync": "diff src/styles/tokens.css ${SPLINE_DIR:-../../spline-app/frontend}/src/styles/tokens.css && diff src/styles/app.css ${SPLINE_DIR:-../../spline-app/frontend}/src/styles/app.css && echo styles-in-sync || echo \"sibling missing or drifted (non-fatal)\"",
    "lint": "eslint src netlify/functions"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@turf/boolean-contains": "^7.3.5",
    "@turf/boolean-overlap": "^7.3.5",
    "@turf/difference": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "fflate": "^0.8.3",
    "jsts": "^2.12.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "adm-zip": "^0.6.0",
    "brace-expansion": "^1.1.16",
    "postcss": "^8.5.18"
  }
}
