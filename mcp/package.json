{
  "name": "opentakeoff-mcp",
  "version": "0.9.49",
  "mcpName": "io.github.Kentucky-ai/opentakeoff",
  "type": "module",
  "description": "OpenTakeoff MCP server — drive the takeoff engine from your MCP client over stdio.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --import tsx server.ts",
    "start": "node dist/server.js",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server-core.js && node scripts/finish-build.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/conformance.test.ts test/context.test.ts test/e2e.test.ts test/labels.test.ts test/parity.test.ts test/raster.test.ts test/resources.test.ts test/safewrite.test.ts test/scalewarn.test.ts test/session.test.ts test/staging.test.ts test/tools.test.ts test/transitions.test.ts test/twins.test.ts test/view.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@turf/boolean-contains": "^7.4.0",
    "@turf/boolean-overlap": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.100"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "bin": {
    "opentakeoff-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kentucky-ai/opentakeoff.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/Kentucky-ai/opentakeoff/tree/main/mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "takeoff",
    "construction",
    "estimating",
    "pdf",
    "quantity-takeoff",
    "flooring",
    "ai-agent",
    "agentic-ai",
    "preconstruction",
    "construction-management",
    "project-management"
  ],
  "overrides": {
    "fast-uri": "^3.1.4",
    "@hono/node-server": "^2.0.5"
  }
}
